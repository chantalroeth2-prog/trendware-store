# ============================================================
# STRIPE KONFIGURATION
# ============================================================
# 1. Erstelle einen Account auf https://stripe.com
# 2. Gehe zu Developers > API Keys
# 3. Kopiere die Test-Keys hierher (beginnen mit "sk_test_" und "pk_test_")
#
# WICHTIG: Fuer den Live-Betrieb die Live-Keys verwenden (sk_live_ / pk_live_)
# ============================================================

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_DEIN_KEY_HIER
STRIPE_SECRET_KEY=sk_test_DEIN_KEY_HIER
STRIPE_WEBHOOK_SECRET=whsec_DEIN_WEBHOOK_SECRET

# ============================================================
# PAYPAL KONFIGURATION
# ============================================================
# 1. Erstelle einen Developer Account: https://developer.paypal.com
# 2. Gehe zu: Apps & Credentials > Sandbox (oder Live)
# 3. Erstelle eine neue App oder nutze die Default-App
# 4. Kopiere Client ID und Secret hierher
#
# PAYPAL_MODE: "sandbox" fuer Tests, "live" fuer echte Zahlungen
# ============================================================

NEXT_PUBLIC_PAYPAL_CLIENT_ID=DEIN_PAYPAL_CLIENT_ID_HIER
PAYPAL_CLIENT_SECRET=DEIN_PAYPAL_SECRET_HIER
PAYPAL_MODE=sandbox

# Erst nach erfolgreichem Live-End-to-End-Test auf true setzen.
PAYMENTS_LIVE_ENABLED=false
NEXT_PUBLIC_PAYMENTS_LIVE_ENABLED=false

# ============================================================
# ALLGEMEIN
# ============================================================

# Shop-URL (fuer Redirects nach Zahlung)
NEXT_PUBLIC_BASE_URL=https://trendware7.store

# ============================================================
# KI-PRODUKTAGENT
# ============================================================
# Vercel KV (wird automatisch gesetzt bei KV-Setup im Vercel Dashboard)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# SerpAPI Key (https://serpapi.com)
SERPAPI_API_KEY=

# Cron-Auth (zufaelliger String, wird in Vercel als CRON_SECRET gesetzt)
CRON_SECRET=

# JWT-Signierung fuer Bestaetigungs-Links (zufaelliger String)
AGENT_APPROVE_SECRET=

# Resend API Key fuer E-Mail-Versand (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=TrendWare <noreply@trendware7.store>
NEWSLETTER_ENABLED=false
NEXT_PUBLIC_VAT_ID=

# IndexNow Key fuer Bing/Yandex Indexierung (beliebiger hex-String, z.B. via uuidgen)
# Muss auch als {KEY}.txt im public-Ordner abgelegt werden
INDEXNOW_KEY=
